---
import '../styles/global.css';
import { person, links, googleAnalyticsId } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = `${person.name} · ${person.role}`,
  description = 'Abdul Hannan Kanji builds machine learning models for Play Ads at Google.',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(person.portrait.src, Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="oklch(82% 0.15 78)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <link rel="icon" href="/assets/favicon.ico" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:ital,wght@0,400;0,700;1,400&family=Bricolage+Grotesque:opsz,wght@12..96,500..800&display=swap"
    />

    {
      import.meta.env.PROD && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`} />
          <script is:inline define:vars={{ googleAnalyticsId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', googleAnalyticsId);
          </script>
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <footer class="site-footer">
      <div class="footer-inner">
        <p class="footer-name">{person.name}</p>
        <nav aria-label="Elsewhere">
          <ul>
            <li><a href={`mailto:${person.email}`}>Email</a></li>
            <li><a href={links.resume}>Resume</a></li>
            <li><a href={links.linkedin} rel="me">LinkedIn</a></li>
            <li><a href={links.github} rel="me">GitHub</a></li>
            <li><a href={links.scholar}>Scholar</a></li>
          </ul>
        </nav>
        <p class="footer-fine">© {year}</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-footer {
    margin-top: clamp(4rem, 8vw, 8rem);
    background: var(--ink);
    color: var(--paper);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1rem 2.5rem;
    padding: 2.5rem var(--gutter) 3rem;
  }

  .footer-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    margin-right: auto;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    color: var(--marigold);
  }

  a:hover {
    color: var(--paper);
  }

  .site-footer :focus-visible {
    outline-color: var(--marigold);
  }

  .footer-fine {
    font-size: var(--step--1);
    color: oklch(80% 0.02 255);
  }
</style>
