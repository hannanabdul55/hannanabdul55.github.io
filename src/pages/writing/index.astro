---
import { getCollection } from 'astro:content';
import Page from '../../components/Page.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeZone: 'UTC' });
---

<Page title="Writing" description="Notes by Abdul Hannan Kanji." noindex={posts.length === 0}>
  <h1>Writing</h1>
  {
    posts.length === 0 ? (
      <>
        <p>Nothing here yet. Notes on machine learning, reinforcement learning, and ML safety are in the works.</p>
        <p>
          Until then, <a href="/">the home page</a> covers what I work on.
        </p>
      </>
    ) : (
      <ul class="posts">
        {posts.map((post) => (
          <li>
            <a href={`/writing/${post.id}`}>{post.data.title}</a>
            <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
            <p>{post.data.description}</p>
          </li>
        ))}
      </ul>
    )
  }
</Page>

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2rem;
  }

  .posts a {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
  }

  time {
    display: block;
    margin: 0.25rem 0 0.5rem;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }
</style>
